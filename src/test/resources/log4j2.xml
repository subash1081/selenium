<?xml version="1.0" encoding="UTF-8"?>




<Configuration status="WARN">




<Appenders>




<!-- Console Log -->

<Console name="Console" target="SYSTEM_OUT">

<PatternLayout

pattern="%d{dd-MM-yyyy HH:mm:ss} [%level] %c{1} - %msg%n" />

</Console>




<!-- File Log -->

<File name="File"

fileName="target/logs/automation.log">




<PatternLayout

pattern="%d{dd-MM-yyyy HH:mm:ss} [%level] %c{1} - %msg%n" />




</File>




</Appenders>




<Loggers>




<Root level="info">

<AppenderRef ref="Console" />

<AppenderRef ref="File" />

</Root>




</Loggers>




</Configuration>